{"id": "arcsin_form_zero_to_b", "unit": "SM4", "atom": "spec.integ.arcsin_form", "template": "Evaluate ∫₀^{b} 1/√({csq} − x²) dx.", "vars": {"c": {"type": "int", "min": 2, "max": 17}, "b": {"type": "int", "min": 1, "max": 16}}, "constraints": ["b < c"], "derive": {"csq": "c * c"}, "args": {"c": {"question": "c"}, "a": {"literal": 0}, "b": {"question": "b"}}}
{"id": "arcsin_form_a_to_b", "unit": "SM4", "atom": "spec.integ.arcsin_form", "template": "Evaluate ∫_{a}^{b} 1/√({csq} − x²) dx.", "vars": {"c": {"type": "int", "min": 3, "max": 9}, "a": {"type": "int", "min": -8, "max": 7}, "b": {"type": "int", "min": -7, "max": 8}}, "constraints": ["a < b", "abs(a) < c", "abs(b) < c"], "derive": {"csq": "c * c"}, "args": {"c": {"question": "c"}, "a": {"question": "a"}, "b": {"question": "b"}}}
