{"id": "partial_frac_unit", "unit": "SM4", "atom": "spec.integ.partial_frac", "template": "Find (A, B) such that 1/((x − {p})(x − {q})) = A/(x − {p}) + B/(x − {q}).", "vars": {"p": {"type": "int", "min": -6, "max": 6}, "q": {"type": "int", "min": -6, "max": 6, "exclude": ["p"]}}, "args": {"A": {"literal": 1}, "p": {"question": "p"}, "q": {"question": "q"}}}
{"id": "partial_frac_coeff", "unit": "SM4", "atom": "spec.integ.partial_frac", "template": "Express {A}/((x − {p})(x − {q})) as M/(x − {p}) + N/(x − {q}). Find (M, N).", "vars": {"A": {"type": "int", "min": 1, "max": 6}, "p": {"type": "int", "min": -4, "max": 4}, "q": {"type": "int", "min": -4, "max": 4, "exclude": ["p"]}}, "args": {"A": {"question": "A"}, "p": {"question": "p"}, "q": {"question": "q"}}}
{"id": "by_parts_compute", "unit": "SM4", "atom": "spec.integ.by_parts_step", "template": "Let u(x) and v(x) be differentiable functions with u({b}) = {u_b}, v({b}) = {v_b}, u({a}) = {u_a}, and v({a}) = {v_a}. Given that ∫_{{a}}^{{b}} v(x) u'(x) dx = {iv}, find the exact value of ∫_{{a}}^{{b}} u(x) v'(x) dx.", "vars": {"a": {"type": "int", "min": 0, "max": 2}, "b": {"type": "int", "min": 3, "max": 6}, "u_b": {"type": "int", "min": 1, "max": 6}, "v_b": {"type": "int", "min": 1, "max": 6}, "u_a": {"type": "int", "min": 0, "max": 3}, "v_a": {"type": "int", "min": 0, "max": 3}, "iv": {"type": "int", "min": 1, "max": 10}}, "constraints": ["a < b"], "args": {"uv_upper": {"question": "uv_hi"}, "uv_lower": {"question": "uv_lo"}, "integral_vdu": {"question": "iv"}}, "derive": {"uv_hi": "u_b * v_b", "uv_lo": "u_a * v_a"}}
{"id": "by_parts_boundary", "unit": "SM4", "atom": "spec.integ.by_parts_step", "template": "Two differentiable functions f(x) and g(x) satisfy f({b})g({b}) − f({a})g({a}) = {boundary}. If ∫_{{a}}^{{b}} g(x) f'(x) dx = {iv}, evaluate ∫_{{a}}^{{b}} f(x) g'(x) dx.", "vars": {"a": {"type": "int", "min": 0, "max": 2}, "b": {"type": "int", "min": 3, "max": 6}, "boundary": {"type": "int", "min": 2, "max": 30}, "iv": {"type": "int", "min": 1, "max": 15}}, "args": {"uv_upper": {"question": "boundary"}, "uv_lower": {"literal": 0}, "integral_vdu": {"question": "iv"}}}
{"id": "volume_frac", "unit": "SM4", "atom": "spec.integ.volume_disk", "template": "Find the exact volume of the solid generated when the region bounded by y = √({k_disp}), the x-axis, and the vertical lines x = 0 and x = 1 is rotated about the x-axis.", "vars": {"p": {"type": "int", "min": 1, "max": 30}, "q": {"type": "int", "min": 2, "max": 15}}, "derive": {"k_val": "Fraction(p, q)", "k_disp": "str(Fraction(p, q))"}, "args": {"integral_f_sq": {"question": "k_val"}}}
