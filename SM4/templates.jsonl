{"id": "implicit_grad_find", "unit": "SM4", "atom": "spec.deriv.implicit_grad", "template": "At a point on F(x, y) = 0, ∂F/∂x = {Fx} and ∂F/∂y = {Fy}. Find dy/dx.", "vars": {"Fx": {"type": "int", "min": -9, "max": 9}, "Fy": {"type": "int", "min": -9, "max": 9, "exclude": [0]}}, "args": {"F_x": {"question": "Fx"}, "F_y": {"question": "Fy"}}}
{"id": "implicit_grad_eval", "unit": "SM4", "atom": "spec.deriv.implicit_grad", "template": "A curve is defined implicitly by the equation F(x, y) = 0. At a given point on the curve, the partial derivatives are ∂F/∂x = {Fx} and ∂F/∂y = {Fy}. Determine the gradient dy/dx of the curve at this point.", "vars": {"Fx": {"type": "int", "min": -9, "max": 9}, "Fy": {"type": "int", "min": -9, "max": 9, "exclude": [0]}}, "args": {"F_x": {"question": "Fx"}, "F_y": {"question": "Fy"}}}
{"id": "related_rate_find", "unit": "SM4", "atom": "spec.deriv.related_rate", "template": "A particle moves along a curve with tangent slope {dydx_disp} at the current point. Its horizontal velocity is dx/dt = {dxdt_disp}. Find the vertical velocity dy/dt.", "vars": {"p": {"type": "int", "min": -6, "max": 6, "exclude": [0]}, "q": {"type": "int", "min": 1, "max": 6}, "r": {"type": "int", "min": -6, "max": 6, "exclude": [0]}, "s": {"type": "int", "min": 1, "max": 6}}, "derive": {"dydx_val": "Fraction(p, q)", "dxdt_val": "Fraction(r, s)", "dydx_disp": "str(Fraction(p, q))", "dxdt_disp": "str(Fraction(r, s))"}, "args": {"dy_dx": {"question": "dydx_val"}, "dx_dt": {"question": "dxdt_val"}}}
{"id": "related_rate_context", "unit": "SM4", "atom": "spec.deriv.related_rate", "template": "A quantity y depends on x, and x changes with time. At a certain moment dy/dx = {dydx_disp} and dx/dt = {dxdt_disp}. Determine dy/dt.", "vars": {"p": {"type": "int", "min": -6, "max": 6, "exclude": [0]}, "q": {"type": "int", "min": 1, "max": 6}, "r": {"type": "int", "min": -6, "max": 6, "exclude": [0]}, "s": {"type": "int", "min": 1, "max": 6}}, "derive": {"dydx_val": "Fraction(p, q)", "dxdt_val": "Fraction(r, s)", "dydx_disp": "str(Fraction(p, q))", "dxdt_disp": "str(Fraction(r, s))"}, "args": {"dy_dx": {"question": "dydx_val"}, "dx_dt": {"question": "dxdt_val"}}}
{"id": "solve_direct_ic", "unit": "SM4", "atom": "spec.diffeq.solve_direct", "template": "Solve the differential equation dy/dx = {k} subject to the initial condition y(0) = {y0}. Find the value of y({x1}).", "vars": {"k": {"type": "int", "min": 1, "max": 10}, "y0": {"type": "int", "min": 1, "max": 20}, "x1": {"type": "int", "min": 1, "max": 8}}, "args": {"y0": {"question": "y0"}, "integral_value": {"question": "I_val"}}, "derive": {"I_val": "k * x1"}}
{"id": "solve_direct_interpret", "unit": "SM4", "atom": "spec.diffeq.solve_direct", "template": "A particle moves in a straight line with constant velocity v(t) = {v} m/s. Its initial position at time t = 0 is s(0) = {s0} m. Find the position of the particle at time t = {t1} s.", "vars": {"v": {"type": "int", "min": 1, "max": 12}, "s0": {"type": "int", "min": 1, "max": 20}, "t1": {"type": "int", "min": 1, "max": 8}}, "args": {"y0": {"question": "s0"}, "integral_value": {"question": "disp_val"}}, "derive": {"disp_val": "v * t1"}}
{"id": "shm_displacement", "unit": "SM4", "atom": "spec.dynamics.shm_eval", "template": "x(t) = {A} cos({omega_disp}t{phi_term}). Find x({t}).", "cases": [{"omega_k": 1, "omega_disp": "π"}, {"omega_k": 2, "omega_disp": "π/2"}, {"omega_k": 3, "omega_disp": "π/3"}, {"omega_k": 6, "omega_disp": "π/6"}], "vars": {"A": {"type": "int", "min": 1, "max": 6}, "phi_m": {"type": "int", "min": 0, "max": 5}, "t": {"type": "int", "min": 1, "max": 6}}, "derive": {"omega_val": "pi / omega_k", "phi_val": "pi * Fraction(phi_m, 6)", "phi_term": "'' if phi_m == 0 else ' + ' + ['π/6','π/3','π/2','2π/3','5π/6'][phi_m - 1]"}, "args": {"A": {"question": "A"}, "omega": {"question": "omega_val"}, "phi": {"question": "phi_val"}, "t": {"question": "t"}}}
{"id": "shm_from_params", "unit": "SM4", "atom": "spec.dynamics.shm_eval", "template": "A particle in SHM has amplitude {A}, angular frequency ω = {omega_disp}, and phase φ = {phi_disp}. Find the displacement at t = {t}.", "cases": [{"omega_k": 1, "omega_disp": "π"}, {"omega_k": 2, "omega_disp": "π/2"}, {"omega_k": 3, "omega_disp": "π/3"}, {"omega_k": 6, "omega_disp": "π/6"}], "vars": {"A": {"type": "int", "min": 1, "max": 6}, "phi_m": {"type": "int", "min": 0, "max": 5}, "t": {"type": "int", "min": 1, "max": 6}}, "derive": {"omega_val": "pi / omega_k", "phi_val": "pi * Fraction(phi_m, 6)", "phi_disp": "['0','π/6','π/3','π/2','2π/3','5π/6'][phi_m]"}, "args": {"A": {"question": "A"}, "omega": {"question": "omega_val"}, "phi": {"question": "phi_val"}, "t": {"question": "t"}}}
{"id": "margin_error_direct", "unit": "SM4", "atom": "spec.stats.margin_of_error", "template": "A normal distribution sample of size n = {n} has standard deviation s = {s}. Find the margin of error of the confidence interval using critical value z = {z}.", "vars": {"z": {"type": "int", "min": 1, "max": 5}, "s": {"type": "int", "min": 1, "max": 12}, "n": {"type": "choice", "values": [1, 4, 9, 16, 25, 36, 49, 64, 81, 100]}}, "args": {"z": {"question": "z"}, "s": {"question": "s"}, "n": {"question": "n"}}}
{"id": "margin_error_context", "unit": "SM4", "atom": "spec.stats.margin_of_error", "template": "A sample of {n} observations has standard deviation s = {s}. Using z-value {z}, calculate the margin of error for the confidence interval.", "vars": {"z": {"type": "int", "min": 1, "max": 5}, "s": {"type": "int", "min": 1, "max": 12}, "n": {"type": "choice", "values": [4, 9, 16, 25, 36, 49, 64, 81, 100, 121]}}, "args": {"z": {"question": "z"}, "s": {"question": "s"}, "n": {"question": "n"}}}
